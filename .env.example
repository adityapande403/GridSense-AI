# GridSense-AI Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Application Environment
PROJECT_NAME="GridSense-AI"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# Database Connection (Default: SQLite for local zero-dependency runs)
# For PostgreSQL / PostGIS in Docker: postgresql+psycopg2://postgres:postgres@localhost:5432/gridsense
DATABASE_URL="sqlite:///./gridsense_dev.db"

# JWT / Security Token Key (Must be set to a strong random secret in production)
SECRET_KEY="replace-with-a-secure-random-secret-in-production"

# Optional Basemap Configuration
# VITE_CARTO_API_KEY=""
